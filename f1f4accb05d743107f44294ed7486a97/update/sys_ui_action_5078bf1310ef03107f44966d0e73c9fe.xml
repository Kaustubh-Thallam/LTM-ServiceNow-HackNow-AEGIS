        <name>Confirm Candidate &amp; Schedule Interviews</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[(function() {

    var interviewGR = new GlideRecord('x_snc_aegis_interview');

    // Find all interviews belonging to this Job Requisition
    interviewGR.addQuery('application.requisition', current.getUniqueValue());

    // Only process interviews waiting for candidate confirmation
    interviewGR.addQuery('interview_status', 'PENDING_CONFIRMATION');

    interviewGR.query();

    var count = 0;

    while (interviewGR.next()) {

        interviewGR.setValue('interview_status', 'SCHEDULED');
        interviewGR.setValue('candidate_confirmed', true);

        interviewGR.update();

        count++;
    }

    gs.addInfoMessage(
        'Candidate confirmed. ' + count + ' interview(s) scheduled.'
    );

    // Move Job Requisition to Interview in Progress
    current.setValue('stage', 'INTERVIEW_IN_PROGRESS');
    current.update();

    action.setRedirectURL(current);

})();]]></script>
