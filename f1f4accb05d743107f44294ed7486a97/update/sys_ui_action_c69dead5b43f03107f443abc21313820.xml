        <script><![CDATA[(function() {
  // Server-side guard: comments must be filled before resubmitting
  if (!current.getValue('additional_comments')) {
    gs.addErrorMessage('Please enter Additional comments before resubmitting.');
    action.setRedirectURL(current);
    return;
  }

  current.setValue('approval_state', 'requested');   // use the exact choice value from your dictionary
  current.update();

  gs.addInfoMessage('Job Requisition resubmitted. Approval state is now Requested.');
  action.setRedirectURL(current);
})();]]></script>
