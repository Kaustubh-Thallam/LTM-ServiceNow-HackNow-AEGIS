        <name>Run Feedback Agent</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[(function() {
    try {
        // Inputs must match the subflow's input variable names exactly
        var inputs = {};
        inputs['jr_sys_id'] = current.getUniqueValue();
        inputs['number'] = current.getValue('number');

        // Run the subflow in the background
        sn_fd.FlowAPI.getRunner()
            .subflow('x_snc_aegis.run_feedback_agent')
            .inBackground()
            .withInputs(inputs)
            .run();

        gs.addInfoMessage('Feedback Agent has been started for ' + current.getValue('number') + '.');

    } catch (ex) {
        var msg = ex.getMessage ? ex.getMessage() : String(ex);
        gs.error('Run Feedback Agent Error: ' + msg);
        gs.addErrorMessage('Unable to start the Feedback Agent: ' + msg);
    }

    action.setRedirectURL(current);
})();]]></script>
